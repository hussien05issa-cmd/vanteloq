# Vanteloq currently uses Sites-managed D1 and dispatch-owned authentication.
# No application secret is required for local interface development.
#
# Future provider credentials must be configured through the hosted encrypted
# environment and documented here by variable name only. Never add values.

# Optional public site analytics. The measurement identifier is public and
# enables Google Analytics only after the visitor explicitly allows analytics.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Lightspeed Retail X-Series read-only connector. The unprefixed legacy names
# remain supported during migration, but new hosted configuration uses X names.
LIGHTSPEED_X_CLIENT_ID=
LIGHTSPEED_X_CLIENT_SECRET=
LIGHTSPEED_X_REDIRECT_URI=https://vanteloq.com/api/v1/integrations/lightspeed/callback
LIGHTSPEED_X_API_VERSION=2026-07
LIGHTSPEED_X_TOKEN_ENCRYPTION_KEY=
LIGHTSPEED_R_CLIENT_ID=
LIGHTSPEED_R_CLIENT_SECRET=
LIGHTSPEED_R_REDIRECT_URI=https://vanteloq.com/api/v1/integrations/lightspeed-r/callback
INTEGRATION_ENCRYPTION_KEY=

# Stripe merchant financial-data connector. This is a read-only staging
# integration; Vanteloq does not create charges or store payment credentials.
STRIPE_CLIENT_ID=
STRIPE_SECRET_KEY=
STRIPE_REDIRECT_URI=https://vanteloq.hussien05issa.chatgpt.site/api/v1/integrations/stripe/callback
STRIPE_WEBHOOK_SECRET=
# Separate endpoint secret for Vanteloq subscription and invoice events.
STRIPE_BILLING_WEBHOOK_SECRET=
# Optional. Leave blank to use the Stripe account's pinned API version.
STRIPE_API_VERSION=

# QuickBooks Online company verification connector. Sandbox verifies the OAuth
# and company-selection boundary only. Ledger import and production data use
# remain blocked until mapping, reconciliation, and recovery tests are complete.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=https://vanteloq.com/api/v1/integrations/quickbooks/callback
QUICKBOOKS_ENV=sandbox

# Canada Post AddressComplete verifies business addresses during onboarding.
# Keep this key server-side. The browser receives filtered suggestions and a
# short-lived signed verification proof, never the provider key itself.
ADDRESSCOMPLETE_API_KEY=

# Square OAuth connector. Use sandbox during testing and production only after
# the production redirect and signed webhook subscription are registered.
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_REDIRECT_URI=https://connectors.vanteloq.com/api/v1/integrations/square/callback
SQUARE_ENV=production
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=https://connectors.vanteloq.com/api/v1/integrations/square/webhook

# Plaid read-only banking connector for BookLoQ. Sandbox is suitable only for
# synthetic testing. Production requires Plaid approval, registered redirects,
# institution testing and a verified public webhook endpoint.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=https://vanteloq.com/api/v1/integrations/plaid/webhook
PLAID_REDIRECT_URI=https://vanteloq.com

# Google visibility connection: Business Profile performance and on-demand
# review response, Search Console, Analytics, and optional Google Ads reporting.
# Exact resource selection, owned-location scope, and sample approval must be
# completed before production measurement import. Review content is never
# persisted by Vanteloq and replies require a separate explicit confirmation.
GOOGLE_MARKETING_CLIENT_ID=
GOOGLE_MARKETING_CLIENT_SECRET=
GOOGLE_MARKETING_REDIRECT_URI=https://vanteloq.com/api/v1/integrations/google/callback
# Optional: enables read-only Google Ads discovery and reporting. A Google Ads
# OAuth Cloud project needs Google Ads API access. This flag is not proof of approval. The login customer
# is needed only when reporting through a manager account.
GOOGLE_ADS_ENABLED=false
# Legacy migration fallback only; no longer sent to Google.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25

# Meta Marketing API measurement. Production businesses require Meta app
# review for the requested business and advertising permissions.
META_MARKETING_APP_ID=
META_MARKETING_APP_SECRET=
META_MARKETING_REDIRECT_URI=https://vanteloq.com/api/v1/integrations/meta/callback
META_GRAPH_API_VERSION=v25.0

# Optional reviewed HTTPS MapLibre style. Without this, the local opportunity
# panel shows confirmed coordinates and an honest provider-not-configured state.
NEXT_PUBLIC_LOCAL_MAP_STYLE_URL=

# BookLoQ customer invoice delivery. The sender domain must be verified in
# Resend before production messages can be delivered.
RESEND_API_KEY=
INVOICE_EMAIL_FROM=Vanteloq Invoices <invoices@vanteloq.com>
INVOICE_EMAIL_REPLY_TO=support@vanteloq.com

# Internal founder access is disabled by default so every customer account,
# including the founder account, must complete Stripe billing in production.
VANTELOQ_INTERNAL_ACCESS_ENABLED=false

# Supabase transition foundation. Keep the secret key server-side in the
# hosted encrypted environment. "shadow" enables readiness checks without
# replacing Sites-managed D1 as the operating source of truth.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_AUTH_MODE=public
SUPABASE_SCHEMA=public
SUPABASE_BACKEND_MODE=off

# Cloudflare Turnstile protects public account creation. The site key is
# public; keep the secret key only in the hosted encrypted environment.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_ACTION=signup
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1,vanteloq.com,vanteloq.hussien05issa.chatgpt.site
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=https://vanteloq.com/api/v1/integrations/shopify-pos/callback
SHOPIFY_WEBHOOK_URL=https://vanteloq.com/api/v1/integrations/shopify-pos/webhook
SHOPIFY_COMMERCE_REDIRECT_URI=https://vanteloq.com/api/v1/integrations/shopify/callback
SHOPIFY_COMMERCE_WEBHOOK_URL=https://vanteloq.com/api/v1/integrations/shopify/webhook

# Vanteloq AI: OpenAI server-side credentials only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Document processing. Keys are server-side secrets. Copy the exact endpoints
# from the dedicated Azure resources. Verify Defender scanning and Standard S0
# extraction with complete files before production activation.
AZURE_DOCUMENT_SCAN_KEY=
AZURE_DOCUMENT_SCAN_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
