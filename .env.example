# Vanteloq currently uses Sites-managed D1 and dispatch-owned authentication.
# No application secret is required for local interface development.
#
# Future provider credentials must be configured through the hosted encrypted
# environment and documented here by variable name only. Never add values.

# Lightspeed Retail X-Series read-only connector. The unprefixed legacy names
# remain supported during migration, but new hosted configuration uses X names.
LIGHTSPEED_X_CLIENT_ID=
LIGHTSPEED_X_CLIENT_SECRET=
LIGHTSPEED_X_REDIRECT_URI=https://vanteloq.com/api/v1/integrations/lightspeed/callback
LIGHTSPEED_X_API_VERSION=2026-07
LIGHTSPEED_X_TOKEN_ENCRYPTION_KEY=
LIGHTSPEED_R_CLIENT_ID=
LIGHTSPEED_R_CLIENT_SECRET=
LIGHTSPEED_R_REDIRECT_URI=https://vanteloq.com/api/v1/integrations/lightspeed-r/callback
INTEGRATION_ENCRYPTION_KEY=

# Stripe merchant financial-data connector. This is a read-only staging
# integration; Vanteloq does not create charges or store payment credentials.
STRIPE_CLIENT_ID=
STRIPE_SECRET_KEY=
STRIPE_REDIRECT_URI=https://vanteloq.hussien05issa.chatgpt.site/api/v1/integrations/stripe/callback
STRIPE_WEBHOOK_SECRET=
# Separate endpoint secret for Vanteloq subscription and invoice events.
STRIPE_BILLING_WEBHOOK_SECRET=
# Optional. Leave blank to use the Stripe account's pinned API version.
STRIPE_API_VERSION=

# Plaid read-only banking connector for BookLoQ. Sandbox is suitable only for
# synthetic testing. Production requires Plaid approval, registered redirects,
# institution testing and a verified public webhook endpoint.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=https://vanteloq.com/api/v1/integrations/plaid/webhook
PLAID_REDIRECT_URI=https://vanteloq.com

# Google measurement connection: Business Profile performance and reviews,
# Search Console, and Google Analytics reporting. Google must approve the OAuth
# consent screen and APIs before a production account can authorize access.
GOOGLE_MARKETING_CLIENT_ID=
GOOGLE_MARKETING_CLIENT_SECRET=
GOOGLE_MARKETING_REDIRECT_URI=https://vanteloq.com/api/v1/integrations/google/callback

# Meta Marketing API measurement. Production businesses require Meta app
# review for the requested business and advertising permissions.
META_MARKETING_APP_ID=
META_MARKETING_APP_SECRET=
META_MARKETING_REDIRECT_URI=https://vanteloq.com/api/v1/integrations/meta/callback
META_GRAPH_API_VERSION=v25.0

# Supabase transition foundation. Keep the secret key server-side in the
# hosted encrypted environment. "shadow" enables readiness checks without
# replacing Sites-managed D1 as the operating source of truth.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_AUTH_MODE=public
SUPABASE_SCHEMA=public
SUPABASE_BACKEND_MODE=off

# Cloudflare Turnstile protects public account creation. The site key is
# public; keep the secret key only in the hosted encrypted environment.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_ACTION=signup
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1,vanteloq.com,vanteloq.hussien05issa.chatgpt.site
